# Copy to .dev.vars for local development (npm run dev). Never commit .dev.vars.
# Local SQLite file; the dev server runs migrations on start. Production uses the D1 binding in wrangler.toml.
DATABASE_URL=file:.data/landed.db
# Optional. Scripts (npm run seed) and the first-user setup use it; the admin app itself signs in with email + password.
ADMIN_API_KEY=change-me
# Leave STRIPE_* empty to run without card payments (admin can record cash/bank deposits).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Leave RESEND_* empty to log emails instead of sending them (Admin > Emails shows them).
RESEND_API_KEY=
RESEND_FROM=Landed <hello@landed.scot>
ORDER_EMAIL=hello@example.com
WHATSAPP_NUMBER=
SITE_URL=http://localhost:8788
