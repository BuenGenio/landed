{
  "name": "landed",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Arrival kits, winter kits and summer storage for Aberdeen students - pre-order page, fulfilment backend, admin console and pitch deck",
  "scripts": {
    "dev": "npm run site:build && node scripts/dev.js",
    "web": "npm run site:build && node scripts/dev.js",
    "db:migrate": "node db/migrate.js",
    "test": "node --test test/*.test.js",
    "deck": "node deck/build_deck.js",
    "pages:dev": "npm run build && wrangler pages dev web --port 8790",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler pages deploy web",
    "i18n": "node scripts/i18n-check.cjs",
    "deploy:gh-pages": "git subtree push --prefix web origin gh-pages",
    "icons": "node scripts/fetch-icons.cjs",
    "admin:dev": "vite --config admin/vite.config.ts",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:check": "vue-tsc --noEmit -p admin/tsconfig.json",
    "build": "npm run site:build && npm run admin:build",
    "db:migrate:local": "wrangler d1 migrations apply landed --local",
    "db:migrate:remote": "wrangler d1 migrations apply landed --remote",
    "seed": "node scripts/seed.js",
    "site:build": "npm run css && node scripts/build-site.js",
    "css": "tailwindcss -i src/daisy.css -o web/meta/daisy.css --minify",
    "css:watch": "tailwindcss -i src/daisy.css -o web/meta/daisy.css --watch"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.4.0",
    "cheerio": "^1.2.0",
    "daisyui": "^5.7.38",
    "lucide-vue-next": "^1.0.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.0",
    "reka-ui": "^2.10.4",
    "sharp": "^0.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue": "3.5.42",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.70.0"
  }
}
